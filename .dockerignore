# 构建镜像时排除的内容（不影响宿主机的本地开发）

# 版本控制 / 编辑器
.git
.gitignore
.idea
.vscode
.DS_Store

# Python 虚拟环境与缓存
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache

# 运行期数据（不打进镜像）
data
uploads
*.db
.env

# 前端依赖与构建产物（镜像内会重新构建）
frontend/node_modules
frontend/dist
frontend/.vite
frontend/npm-debug.log*

# 测试与文档
tests
*.md

# CI 与本地脚本（无需进镜像）
.github
scripts
