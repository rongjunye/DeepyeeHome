# ==========================================================================
# Git 属性：统一换行符与文件类型，避免跨平台产生大量无意义 diff
# ==========================================================================

# 默认：自动识别文本，检出时用 LF（仓库内统一）
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.db   binary
*.zip  binary

# 前端锁文件保持 LF，保证 CI 上 npm ci 稳定
frontend/package-lock.json text eol=lf

# PowerShell 脚本保留 CRLF（并配合 UTF-8 BOM，确保 Windows PowerShell 5.1 正确解析中文）
*.ps1 text eol=crlf

# 语言统计修正：避免 GitHub 把项目主语言误判为 HTML/CSS
*.py    linguist-language=Python
*.ts    linguist-language=TypeScript
*.tsx   linguist-language=TypeScript