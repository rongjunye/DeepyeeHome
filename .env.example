# ==========================================================================
# NeuroArchAI Platform —— 环境变量示例
# 用法：复制本文件为 .env，然后按需修改
#   cp .env.example .env      (Windows: copy .env.example .env)
# ==========================================================================

# ---------- LLM 驱动方式：groq / ollama / none ----------
# none   —— 零配置，使用内置算法引擎（默认，开箱即用）
# groq   —— 调用 Groq 云端 API（免费额度，速度快，推荐新手）
# ollama —— 调用本地 Ollama（隐私性最好）
LLM_PROVIDER=none

# ---------- 选项一：Groq ----------
# 前往 https://console.groq.com 免费注册并获取 API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- 选项二：Ollama ----------
# 先在本机执行 `ollama run llama2` 下载并启动模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ---------- 视觉模型（用于「AI 识别户型」，可选）----------
# 必须是【支持图片输入】的模型；留空则按 provider 使用内置默认值。
#   Groq 示例:   meta-llama/llama-4-scout-17b-16e-instruct
#   Ollama 示例: qwen2.5vl:7b
# 未配置时「AI 识别户型」会提示不可用，但手动标注房间依然完全可用。
VISION_MODEL=

# ---------- 安全密钥（生产环境务必改成随机长字符串）----------
SECRET_KEY=change-me-in-production-please

# ---------- 数据库（默认 SQLite，无需修改）----------
# DATABASE_URL=sqlite:///./data/neuroarchai.db

# ---------- 其他 ----------
DEBUG=false
MAX_UPLOAD_MB=10
LLM_TIMEOUT=60
